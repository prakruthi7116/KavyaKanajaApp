  { "id": "20", "title": "ತ್ರಿಪದಿ", "poet": "Sarvajna", "verse": "ಮಾತೇ ಮಾಣಿಕ್ಯವಯ್ಯ", "bhavartha": "Words are precious.", "audio_url": "", "image_url": "", "era": "Medieval", "poet_bio": "Sarvajna.", "jnanpith": false, "hard_word": "ಮಾಣಿಕ್ಯ", "word_meaning": "Ruby." },
