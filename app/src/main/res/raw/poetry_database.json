  { "id": "17", "title": "ಕವನ", "poet": "Kuvempu", "verse": "ನೂರಾರು ಹಾದಿ ಹರಿಯಲಿ ನಮ್ಮೊಳಗೆ", "bhavartha": "Let paths of knowledge flow.", "audio_url": "", "image_url": "", "era": "Navodaya", "poet_bio": "Kuvempu.", "jnanpith": true, "hard_word": "ಹರಿಯಲಿ", "word_meaning": "Let it flow." },
  { "id": "18", "title": "ಹಾಡು", "poet": "D. R. Bendre", "verse": "ಇಳಿದು ಬಾ ತಾಯಿ ಇಳಿದು ಬಾ", "bhavartha": "Call for the divine.", "audio_url": "", "image_url": "", "era": "Navodaya", "poet_bio": "Bendre.", "jnanpith": true, "hard_word": "ಇಳಿದು", "word_meaning": "Descending." },
