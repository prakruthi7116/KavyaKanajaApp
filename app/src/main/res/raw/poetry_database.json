  { "id": "39", "title": "ಕಗ್ಗ", "poet": "D. V. Gundappa", "verse": "ಧರ್ಮವೇ ದಾರಿದೀಪವಯ್ಯ", "bhavartha": "Dharma is the light.", "audio_url": "", "image_url": "", "era": "Modern", "poet_bio": "DVG.", "jnanpith": false, "hard_word": "ದಾರಿದೀಪ", "word_meaning": "Guide light." },
  { "id": "40", "title": "ತ್ರಿಪದಿ", "poet": "Sarvajna", "verse": "ನಗು ನಗುತ ಬಾಳು ಹಸನಾಗುವುದು", "bhavartha": "Smile for a better life.", "audio_url": "", "image_url": "", "era": "Medieval", "poet_bio": "Sarvajna.", "jnanpith": false, "hard_word": "ಹಸನಾಗುವುದು", "word_meaning": "Will become better." },
  { "id": "41", "title": "ಕವನ", "poet": "Basavanna", "verse": "ಎಲ್ಲರ ಪ್ರೀತಿಯೇ ದೇವರ ಪೂಜೆ", "bhavartha": "Loving everyone is worship.", "audio_url": "", "image_url": "", "era": "Vachana", "poet_bio": "Basavanna.", "jnanpith": false, "hard_word": "ಪೂಜೆ", "word_meaning": "Worship." },
