  { "id": "27", "title": "ತ್ರಿಪದಿ", "poet": "Sarvajna", "verse": "ವಿದ್ಯೆಯ ಕಲಿತವನೇ ನಿಜವಾದ ಶ್ರೀಮಂತ", "bhavartha": "Education is wealth.", "audio_url": "", "image_url": "", "era": "Medieval", "poet_bio": "Sarvajna.", "jnanpith": false, "hard_word": "ಶ್ರೀಮಂತ", "word_meaning": "Rich person." },
  { "id": "28", "title": "ವಚನ", "poet": "Akka Mahadevi", "verse": "ತನುವಿನ ತಮವ ಅರಿವಿನ ಬೆಳಕಿನಿಂದ ಅಳಿಸು", "bhavartha": "Knowledge erases darkness.", "audio_url": "", "image_url": "", "era": "Vachana", "poet_bio": "Akka Mahadevi.", "jnanpith": false, "hard_word": "ತಮ", "word_meaning": "Darkness." },
