  { "id": "33", "title": "ಕಗ್ಗ", "poet": "D. V. Gundappa", "verse": "ಕಾಲವೇ ದೊಡ್ಡ ವೈದ್ಯವಯ್ಯ", "bhavartha": "Time is a healer.", "audio_url": "", "image_url": "", "era": "Modern", "poet_bio": "DVG.", "jnanpith": false, "hard_word": "ವೈದ್ಯ", "word_meaning": "Doctor." },
  { "id": "34", "title": "ವಚನ", "poet": "Akka Mahadevi", "verse": "ಚೆನ್ನಮಲ್ಲಿಕಾರ್ಜುನನೇ ನನ್ನ ಪ್ರಾಣೇಶ", "bhavartha": "Shiva is my lord.", "audio_url": "", "image_url": "", "era": "Vachana", "poet_bio": "Akka Mahadevi.", "jnanpith": false, "hard_word": "ಪ್ರಾಣೇಶ", "word_meaning": "Lord of life." },
  { "id": "35", "title": "ತ್ರಿಪದಿ", "poet": "Sarvajna", "verse": "ಕಾಯಕವೇ ಕೈಲಾಸ ಎಂದು ಅರಿತು ನಡಿ", "bhavartha": "Know work is heaven.", "audio_url": "", "image_url": "", "era": "Medieval", "poet_bio": "Sarvajna.", "jnanpith": false, "hard_word": "ಅರಿತು", "word_meaning": "Knowing." },
  { "id": "36", "title": "ಕವನ", "poet": "Basavanna", "verse": "ಮಾತು ಬೆಳ್ಳಿ ಮೌನ ಬಂಗಾರ", "bhavartha": "Silence is golden.", "audio_url": "", "image_url": "", "era": "Vachana", "poet_bio": "Basavanna.", "jnanpith": false, "hard_word": "ಮೌನ", "word_meaning": "Silence." },
