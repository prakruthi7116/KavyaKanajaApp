  { "id": "31", "title": "ಕವನ", "poet": "Kuvempu", "verse": "ಗಿಡ ಮರಗಳಲಿ ದೈವವ ಕಾಣು", "bhavartha": "God in nature.", "audio_url": "", "image_url": "", "era": "Navodaya", "poet_bio": "Kuvempu.", "jnanpith": true, "hard_word": "ದೈವ", "word_meaning": "Divine." },
