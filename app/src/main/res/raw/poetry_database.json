  { "id": "43", "title": "ಕಗ್ಗ", "poet": "D. V. Gundappa", "verse": "ಬಾಳ ಪಯಣದಲಿ ಪರೋಪಕಾರವೇ ಪುಣ್ಯ", "bhavartha": "Helping others is merit.", "audio_url": "", "image_url": "", "era": "Modern", "poet_bio": "DVG.", "jnanpith": false, "hard_word": "ಪುಣ್ಯ", "word_meaning": "Merit." },
  { "id": "44", "title": "ಕವಿತೆ", "poet": "Kuvempu", "verse": "ಶಾಂತಿಯ ನೆಲೆಯಲಿ ಮನವು ಅರಳಲಿ", "bhavartha": "Mind bloom in peace.", "audio_url": "", "image_url": "", "era": "Navodaya", "poet_bio": "Kuvempu.", "jnanpith": true, "hard_word": "ಅರಳಲಿ", "word_meaning": "Let it bloom." },
  { "id": "45", "title": "ವಚನ", "poet": "Akka Mahadevi", "verse": "ಅರಿವೇ ಗುರುವಾಗಿ ನಮ್ಮನ್ನು ಕಾಯಲಿ", "bhavartha": "Let knowledge protect us.", "audio_url": "", "image_url": "", "era": "Vachana", "poet_bio": "Akka Mahadevi.", "jnanpith": false, "hard_word": "ಕಾಯಲಿ", "word_meaning": "Let it protect." },
